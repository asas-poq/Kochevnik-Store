# название в Swagger и админке
PROJECT_NAME=Ulaanbaatar Cashmere & Leather API
# версия в Swagger
VERSION=2.0.0
# development, test или production. В production слабые секреты не дают запуститься
ENVIRONMENT=development
# префикс API
API_V1_STR=/api/v1
# разрешённые Origin, JSON-список
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "https://ubcashmere.ru"]
# пользователь БД, нужен и compose
POSTGRES_USER=ubcashmere
# пароль БД, нужен и compose
POSTGRES_PASSWORD=ubcashmere_secret
# хост БД при запуске вне Docker
POSTGRES_HOST=localhost
# порт БД
POSTGRES_PORT=5432
# имя БД
POSTGRES_DB=ubcashmere_db
# полный URL, перекрывает POSTGRES_*. Для sqlite: sqlite+aiosqlite:///./dev.db
DATABASE_URL=
# кэш, лимиты, очередь и состояние парсера
REDIS_URL=redis://localhost:6379/0
# секунды жизни кэша каталога
CATALOG_CACHE_TTL=60
# секунды жизни кэша отзывов
REVIEWS_CACHE_TTL=120
# секунды жизни кэша дерева категорий
CATEGORIES_CACHE_TTL=300
# подпись JWT и cookie админки, от 32 символов
SECRET_KEY=replace-with-random-string-of-32-plus-chars
# алгоритм JWT
ALGORITHM=HS256
# жизнь access-токена
ACCESS_TOKEN_EXPIRE_MINUTES=60
# жизнь refresh-токена и сессии
REFRESH_TOKEN_EXPIRE_DAYS=30
# запросов в минуту с IP на регистрацию, вход и refresh
RATE_AUTH_PER_MIN=10
# запросов в минуту с IP на запись отзывов
RATE_REVIEWS_PER_MIN=10
# запросов в минуту на ручки парсера
RATE_PARSER_PER_MIN=6
# запросов в минуту на вебхуки
RATE_WEBHOOK_PER_MIN=120
# адрес S3 или MinIO
S3_ENDPOINT_URL=http://localhost:9000
# публичный адрес, с которого отдаются фото
S3_PUBLIC_BASE_URL=https://cdn.ubcashmere.ru
# ключ S3, нужен и compose для MinIO
S3_ACCESS_KEY=minioadmin
# секрет S3, нужен и compose для MinIO
S3_SECRET_KEY=minioadmin123
# бакет с фото
S3_BUCKET_NAME=ubcashmere-media
# регион S3
S3_REGION=ru-central1
# максимум на файл фото
MAX_IMAGE_MB=10
# максимум файлов в одном запросе
MAX_FILES_PER_REQUEST=10
# максимум фото у товара
MAX_IMAGES_PER_PRODUCT=20
# платёжный провайдер, сейчас только yookassa
PAYMENT_PROVIDER=yookassa
# id магазина. Префикс test_ включает песочницу без реальных платежей
YOOKASSA_SHOP_ID=test_shop_id
# секретный ключ ЮKassa
YOOKASSA_SECRET_KEY=test_secret_key
# секрет вебхука оплаты в песочнице
PAYMENT_WEBHOOK_SECRET=replace-me
# куда вернуть покупателя после оплаты
PAYMENT_RETURN_URL=https://ubcashmere.ru/checkout/success
# внешний адрес API, из него строится ссылка песочницы
PUBLIC_BASE_URL=http://localhost:8000
# через сколько минут неоплаченный заказ отменяется
ORDER_PAYMENT_TTL_MINUTES=30
# бесплатная доставка от этой суммы
FREE_DELIVERY_THRESHOLD_RUB=15000
# стоимость доставки
DELIVERY_COST_RUB=490
# true, если отзывы публикуются после проверки
REVIEWS_PREMODERATION=false
# окно продаж для сортировки по популярности
POPULARITY_WINDOW_DAYS=90
# вес проданных штук
POPULARITY_W_SOLD=5
# вес лайков
POPULARITY_W_LIKES=2
# вес отзывов
POPULARITY_W_REVIEWS=3
# вес рейтинга
POPULARITY_W_RATING=2
# токен бота. Пусто значит демо-режим без отправки
TELEGRAM_BOT_TOKEN=
# личный чат владельца, там кнопки управления заказом
TELEGRAM_OWNER_CHAT_ID=
# группа сотрудников, только статусы
TELEGRAM_STAFF_CHAT_ID=
# id через запятую, кому разрешены кнопки
TELEGRAM_ADMIN_USER_IDS=
# polling или webhook
TELEGRAM_UPDATES_MODE=polling
# секрет для режима webhook
TELEGRAM_WEBHOOK_SECRET=
# сайт-источник
PARSER_BASE_URL=https://ubcashmere.ru
# имя источника в таблице sources
PARSER_SOURCE_NAME=ubcashmere
# пауза между запросами к сайту
PARSER_DELAY_SECONDS=1.5
# таймаут запроса, секунды
PARSER_HTTP_TIMEOUT=30
# попыток на страницу
PARSER_RETRIES=3
# User-Agent парсера, укажите свой контакт
PARSER_USER_AGENT=Mozilla/5.0 (compatible; PriceResearchBot/1.0; +contact: replace-with-your-email)
# куда парсер пишет debug-HTML и CSV
PARSER_DATA_DIR=data/parser
# сколько живёт замок парсера, если воркер умер
PARSER_LOCK_TTL_SECONDS=14400
# остаток нового размера, сайт штуки не отдаёт
PARSER_DEFAULT_STOCK=5
# уровень логов
LOG_LEVEL=INFO
# файл логов, пусто значит только консоль
LOG_FILE=logs/backend.log
# true даёт JSON в консоли
LOG_JSON=false
# отдавать /metrics
METRICS_ENABLED=true
# если задан, /metrics требует Bearer
METRICS_TOKEN=
