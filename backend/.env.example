# ==============================================================================
# Пример конфигурационного файла окружения (.env)
# Скопируйте этот файл в .env и укажите ваши боевые или тестовые ключи
# ==============================================================================

# Общие настройки приложения
PROJECT_NAME="Ulaanbaatar Cashmere & Leather API"
VERSION="1.0.0"
DEBUG=True
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Настройки базы данных (PostgreSQL asyncpg)
POSTGRES_USER=ubcashmere
POSTGRES_PASSWORD=ubcashmere_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ubcashmere_db
# Если переменная DATABASE_URL задана явно, используется она (например, для локального теста можно указать sqlite+aiosqlite:///./ubcashmere.db)
DATABASE_URL=postgresql+asyncpg://ubcashmere:ubcashmere_secret@localhost:5432/ubcashmere_db

# Настройки безопасности и JWT
SECRET_KEY=super_secret_cashmere_jwt_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Настройки S3 / MinIO для хранения фотографий товаров
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_BASE_URL=https://cdn.ubcashmere.ru
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET_NAME=ubcashmere-media
S3_REGION=ru-central1

# Настройки платежной системы СБП (ЮKassa / Т-Касса)
PAYMENT_PROVIDER=yookassa
YOOKASSA_SHOP_ID=test_shop_id_12345
YOOKASSA_SECRET_KEY=test_secret_key_abcdef
PAYMENT_WEBHOOK_SECRET=sbp_webhook_secret_2026
PAYMENT_RETURN_URL=https://ubcashmere.ru/checkout/success
# Публичный адрес бэкенда (для тестовой страницы оплаты в песочнице)
PUBLIC_BASE_URL=http://localhost:8000
# Через сколько минут неоплаченный заказ отменяется (остатки возвращаются на склад)
ORDER_PAYMENT_TTL_MINUTES=30

# Настройки Telegram-бота для уведомлений владельцу магазина
TELEGRAM_BOT_TOKEN=1234567890:AAH_test_bot_token_example
# Личный чат владельца (положительное число) — получает сообщение с КНОПКАМИ управления заказом
TELEGRAM_OWNER_CHAT_ID=123456789
# Группа сотрудников (отрицательное число, бот должен быть в группе) — получает только статусы заказов
TELEGRAM_STAFF_CHAT_ID=-1001234567890
# Доп. Telegram ID (через запятую), которым тоже можно нажимать кнопки (необязательно)
TELEGRAM_ADMIN_USER_IDS=
# polling — для локальной разработки (без домена); webhook — для продакшена (нужен HTTPS); off — выключить кнопки
TELEGRAM_UPDATES_MODE=polling
TELEGRAM_WEBHOOK_SECRET=

# Настройки логирования
LOG_LEVEL=INFO
LOG_FILE=logs/backend.log
